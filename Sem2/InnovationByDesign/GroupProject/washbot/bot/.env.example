# From Meta App Dashboard → WhatsApp → API Setup
WA_TOKEN=paste-your-access-token
WA_PHONE_NUMBER_ID=paste-phone-number-id
# Any string you make up; paste the same one into the webhook settings in Meta
WA_VERIFY_TOKEN=make-up-a-secret-string
# App Dashboard → App settings → Basic → App secret (used to check webhook signatures)
WA_APP_SECRET=paste-app-secret

# The bot's WhatsApp number, digits only with country code (used for the QR links)
BOT_NUMBER=15551234567

# Optional: tags must send this key (header x-tag-key or ?key=) to read their status
TAG_KEY=

TIMEZONE=Asia/Singapore
PORT=3000

# Password for the manager's records page (/admin?key=...). Leave empty to disable outside DEV.
ADMIN_KEY=
# How many days of usage records to keep
HISTORY_DAYS=365

# House alerts to people who haven't messaged the bot in 24 h need an approved
# WhatsApp template with one body variable {{1}} (e.g. "Laundry alert: {{1}}").
WA_ALERT_TEMPLATE=
WA_TEMPLATE_LANG=en
